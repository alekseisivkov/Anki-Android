<?xml version="1.0" encoding="utf-8"?>
<!-- The field for the typed word: a rounded slot, outlined in ink while it has the focus -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <stroke android:width="2dp" android:color="?attr/colorOnSurface" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <stroke android:width="1dp" android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
</selector>
