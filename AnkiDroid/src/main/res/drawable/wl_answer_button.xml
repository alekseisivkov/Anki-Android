<?xml version="1.0" encoding="utf-8"?>
<!-- Answer button of the study screen: a rounded tile with a gap to its neighbours -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/answer_buttons_highlight_color">
    <item android:id="@android:id/mask">
        <inset android:insetLeft="6dp" android:insetRight="6dp" android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="12dp" />
                <solid android:color="@android:color/white" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="6dp" android:insetRight="6dp" android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="12dp" />
                <solid android:color="?attr/answerButtonBackground" />
            </shape>
        </inset>
    </item>
</ripple>
