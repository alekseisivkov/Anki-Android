<?xml version="1.0" encoding="utf-8"?>
<!--
  Personal fork "Wörter": warm paper and ink instead of light blue.
  Blue, red and green mean der/die/das on the cards, so the chrome stays neutral
  and the answer buttons only carry a muted hint of their meaning.
-->
<resources>
    <color name="wl_ink">#24212A</color>
    <color name="wl_ink_raised">#3A3640</color>
    <color name="wl_paper">#FBFAF7</color>
    <color name="wl_paper_selected">#EFECE5</color>
    <color name="wl_tonal">#ECE8DF</color>
    <color name="wl_gold">#F2B33D</color>
    <color name="wl_gold_pressed">#E0A12C</color>
    <color name="wl_again">#5A2E2B</color>
    <color name="wl_again_text">#FFD9D3</color>
    <color name="wl_hard_text">#ECE8F2</color>
    <color name="wl_good">#24452F</color>
    <color name="wl_good_text">#CFEFD8</color>
    <color name="wl_easy">#263D57</color>
    <color name="wl_easy_text">#D5E5FA</color>
    <color name="wl_swipe_good">#2E7A4E</color>
    <color name="wl_swipe_again">#B3382D</color>
    <color name="wl_ink_soft">#4A4550</color>
    <color name="wl_muted">#6E6873</color>
    <color name="wl_panel">#F2EFE9</color>
    <color name="wl_progress_track">#E4DED3</color>

    <style name="Woerter_Light" parent="Base.Theme.Light">
        <item name="colorPrimary">@color/wl_ink</item>
        <item name="colorPrimaryDark">@color/wl_ink</item>
        <item name="colorAccent">@color/wl_ink_raised</item>
        <item name="colorSecondaryContainer">@color/wl_tonal</item>
        <item name="colorSurface">@color/wl_paper</item>
        <item name="colorSurfaceContainerHigh">#F3F1EC</item>
        <item name="colorSurfaceContainer">#0F24212A</item>
        <item name="android:colorBackground">@color/wl_paper</item>
        <item name="android:windowBackground">@color/wl_paper</item>
        <item name="preferenceCategoryTitleTextColor">@color/wl_ink</item>
        <item name="currentDeckBackgroundColor">@color/wl_paper_selected</item>
        <item name="focusedRowBackgroundColor">@color/wl_paper_selected</item>
        <item name="fab_normal">@color/wl_ink</item>
        <item name="fab_pressed">@color/wl_ink_raised</item>
        <item name="customTabNavBarColor">@color/wl_ink</item>
        <item name="progressDialogButtonTextColor">@color/wl_ink</item>
        <item name="incrementerButtonBackground">@color/wl_ink</item>
        <item name="snackbarButtonTextColor">@color/wl_gold</item>
        <item name="snackbarBackgroundTintColor">@color/wl_ink</item>
        <item name="editTextHighlightColor">@color/wl_tonal</item>

        <!-- study screen: ink frame around a paper card -->
        <item name="topBarColor">@color/wl_paper</item>
        <item name="showAnswerColor">@color/wl_ink</item>
        <item name="showAnswerButtonBackground">@color/wl_ink_raised</item>
        <item name="againButtonBackground">@color/wl_again</item>
        <item name="hardButtonBackground">@color/wl_ink_raised</item>
        <item name="goodButtonBackground">@color/wl_good</item>
        <item name="easyButtonBackground">@color/wl_easy</item>
        <item name="againButtonTextColor">@color/wl_again_text</item>
        <item name="hardButtonTextColor">@color/wl_hard_text</item>
        <item name="goodButtonTextColor">@color/wl_good_text</item>
        <item name="easyButtonTextColor">@color/wl_easy_text</item>
        <item name="againButtonRef">@drawable/wl_answer_button</item>
        <item name="hardButtonRef">@drawable/wl_answer_button</item>
        <item name="goodButtonRef">@drawable/wl_answer_button</item>
        <item name="easyButtonRef">@drawable/wl_answer_button</item>
        <item name="againButtonRippleRef">@drawable/wl_answer_button</item>
        <item name="hardButtonRippleRef">@drawable/wl_answer_button</item>
        <item name="goodButtonRippleRef">@drawable/wl_answer_button</item>
        <item name="easyButtonRippleRef">@drawable/wl_answer_button</item>
    </style>

    <!-- The typed answer: one word, centred like the word and the comparison on the answer side -->
    <style name="Woerter_AnswerField">
        <item name="android:background">@drawable/wl_answer_field</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?android:attr/textColorSecondary</item>
    </style>

    <!-- "Начать учиться" on the deck list -->
    <style name="Woerter_StartButton" parent="Widget.Material3.Button.Icon">
        <item name="android:layout_height">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@string/font_fontFamily_medium</item>
        <item name="android:textColor">@color/wl_ink</item>
        <item name="backgroundTint">@color/wl_start_button</item>
        <item name="iconTint">@color/wl_ink</item>
        <item name="iconSize">26dp</item>
        <item name="iconPadding">10dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">3dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- The progress screen: Literata numerals, Roboto words -->
    <style name="Woerter_Progress" />
    <style name="Woerter_Progress.Hero">
        <item name="android:fontFamily">@font/wl_literata_display</item>
        <item name="android:textSize">68sp</item>
        <item name="android:textColor">@color/wl_ink</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Woerter_Progress.HeroLabel">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/wl_ink_soft</item>
    </style>
    <style name="Woerter_Progress.Note">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/wl_muted</item>
    </style>
    <style name="Woerter_Progress.Heading">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@string/font_fontFamily_medium</item>
        <item name="android:textColor">@color/wl_ink</item>
    </style>
    <style name="Woerter_Progress.LegendValue">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@string/font_fontFamily_medium</item>
        <item name="android:textColor">@color/wl_ink</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="Woerter_Progress.LegendLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/wl_muted</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="Woerter_Progress.TileValue">
        <item name="android:fontFamily">@font/wl_literata_numbers</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/wl_ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Woerter_Progress.TileLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/wl_muted</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>
    <style name="Woerter_Progress.RowLabel">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/wl_ink_soft</item>
    </style>
    <style name="Woerter_Progress.RowValue">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@string/font_fontFamily_medium</item>
        <item name="android:textColor">@color/wl_ink</item>
    </style>
</resources>
